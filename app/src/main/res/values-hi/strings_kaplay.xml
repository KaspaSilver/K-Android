    <string name="kp_70142233d6f3" formatted="false">आप इस टूर्नामेंट से बाहर हैं। बाकी ब्रैकेट देखें।</string>
    <string name="kp_07025e915e94" formatted="false">आप इस टूर्नामेंट से बाहर हैं। आप बाकी ब्रैकेट देख सकते हैं।</string>
    <string name="kp_188b806432ca" formatted="false">आपको एक कोड मिलेगा जिसे आप उस व्यक्ति के साथ साझा करें जिससे खेलना चाहते हैं। उनके शामिल होते ही गेम शुरू होगा। इसे बनाना एक लेनदेन है।</string>
    <string name="kp_e7c04dcae100" formatted="false">आप अगले राउंड में पहुंच गए। आपका विरोधी तय होते ही आपका अगला गेम अपने आप खुल जाएगा।</string>
    <string name="kp_5279ac5901b8" formatted="false">आप हार गए</string>
    <string name="kp_db93b3d19f74" formatted="false">पहली चाल आपकी।</string>
    <string name="kp_7ec46c42f060" formatted="false">आपने हार मान ली। %s जीता।</string>
    <string name="kp_85b0b68af5f2" formatted="false">आप पहली सीट लेते हैं और साझा करने के लिए एक कोड पाते हैं। आठ खिलाड़ियों के शामिल होते ही यह शुरू होगा। इसे बनाना एक लेनदेन है।</string>
    <string name="kp_3c2dfe0e1289" formatted="false">आप %d चालों में शह-मात से जीत गए।</string>
    <string name="kp_8dfe694ea61b" formatted="false">आप 1 चाल में शह-मात से जीत गए।</string>
    <string name="kp_8c75d5f7de98" formatted="false">आपने राउंड 1 जीत लिया। अगले विरोधी का इंतज़ार है - तब तक दूसरा गेम देखें।</string>
    <string name="kp_795115417df0" formatted="false">आपने फ़ाइनल जीत लिया। अगले विरोधी का इंतज़ार है - तब तक दूसरा गेम देखें।</string>
    <string name="kp_2987342bd41b" formatted="false">आपने गेम जीत लिया। अगले विरोधी का इंतज़ार है - तब तक दूसरा गेम देखें।</string>
    <string name="kp_ba7e2d06a69c" formatted="false">आपने सेमीफ़ाइनल जीत लिया। अगले विरोधी का इंतज़ार है - तब तक दूसरा गेम देखें।</string>
    <string name="kp_dc9807723538" formatted="false">आपने टूर्नामेंट जीत लिया।</string>
    <string name="kp_e3a4b01eaca8" formatted="false">आप जीत गए!</string>
    <string name="kp_2bd203ba381e" formatted="false">आप पहले से %s में इंतज़ार कर रहे हैं।</string>
    <string name="kp_a91633acc070" formatted="false">आप शामिल हैं। %d और का इंतज़ार…</string>
    <string name="kp_ad79fa22e5b2" formatted="false">आप शामिल हैं। 1 और का इंतज़ार…</string>
    <string name="kp_cfe84965f638" formatted="false">आपकी जोड़ी अगले शामिल होने वाले व्यक्ति से बनेगी। गेम अपने आप शुरू होगा।</string>
    <string name="kp_d80ca7163461" formatted="false">आप %s में खेल रहे हैं</string>
    <string name="kp_24bf6785a61b" formatted="false">आप अभी भी %s में खेल रहे हैं।</string>
    <string name="kp_eec7f86a8bb7" formatted="false">आप %s में इंतज़ार कर रहे हैं</string>
    <string name="kp_61e7335f3c19" formatted="false">आपका 1v1 रिकॉर्ड</string>
    <string name="kp_48fd80af85de" formatted="false">चाल भेजे जाने से पहले आपकी घड़ी का समय खत्म हो गया।</string>
    <string name="kp_a8bc9c75a936" formatted="false">आपका गेम शुरू होने में</string>
    <string name="kp_32ec1dbd797a" formatted="false">आपका शामिल होना नेटवर्क तक नहीं पहुंचा। जब चाहें फिर से शामिल हों।</string>
    <string name="kp_44470e508a5d" formatted="false">आपकी चाल</string>
    <string name="kp_d5b2c846e810" formatted="false">आपकी चाल नहीं गिनी गई। बोर्ड देखें।</string>
    <string name="kp_5277d781ccc7" formatted="false">आपकी चाल नेटवर्क तक नहीं पहुंची। इसे फिर से चलें।</string>
    <string name="kp_63bbbf0226f5" formatted="false">आपका रिकॉर्ड</string>
    <string name="kp_4e15ba26e54d" formatted="false">आपकी सीट %s तक रखी गई है। अगर तब तक रूम नहीं भरता, तो आप कतार से बाहर हो जाएँगे।</string>
    <string name="kp_8774b9393565" formatted="false">आपकी सीट इतनी देर तक रखी जाती है। अगर समय पर कोई शामिल नहीं होता, तो आप कतार से बाहर हो जाते हैं।</string>
    <string name="kp_94ad25364602" formatted="false">आपका टूर्नामेंट रिकॉर्ड</string>
    <string name="kp_114f3f6a8251" formatted="false">आपकी जीत अभी Kaspa पर नहीं है</string>
    <string name="kp_f957097d7a22" formatted="false">समाप्त</string>
    <string name="kp_691a77cd21a3" formatted="false">बनाम</string>
    <string name="kp_aa93adb4f65c" formatted="false">मैंने K पर %s (लेवल %d) को %d चालों में हराया। क्या आप इससे कम में कर सकते हैं?</string>
