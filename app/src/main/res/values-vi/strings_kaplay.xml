    <string name="kp_e0d73143de80" formatted="false">Tham gia</string>
    <string name="kp_c8155c3c34dc" formatted="false">Tham gia (Phí: %s)</string>
    <string name="kp_df7b41919cb2" formatted="false">Tham gia và bạn sẽ được ghép với người tham gia tiếp theo. Khi phòng đầy, ván đấu bắt đầu và phòng tiếp theo mở ra. Mỗi bên năm phút; mỗi nước đi là một giao dịch Kaspa (khoảng 0.0017 KAS mỗi nước). Các ván ở đây được tính vào bảng xếp hạng.</string>
    <string name="kp_dacbf38d4e73" formatted="false">Tham gia bằng mã</string>
    <string name="kp_f44c1e425996" formatted="false">Đang tham gia…</string>
