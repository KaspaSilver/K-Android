    <string name="kp_4401b9c3edce" formatted="false">Có người đã thắng %s trong %d nước. Bạn có làm được với ít nước hơn không?</string>
    <string name="kp_c923aafae8bc" formatted="false">Có người thách bạn đánh bại %s.</string>
