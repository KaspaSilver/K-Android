    <string name="kp_ae768f766f75" formatted="false">Ở lại</string>
    <string name="kp_f300737844cc" formatted="false">Vẫn đang tải các phòng - hãy thử lại sau giây lát.</string>
    <string name="kp_fc55363a83bc" formatted="false">Đang đưa cả hai bạn vào bàn cờ</string>
    <string name="kp_ad30c2ff1d6e" formatted="false">Đang đưa mọi người vào bàn cờ của mình</string>
    <string name="kp_293d8f7d8030" formatted="false">Đang lấy chỗ cho bạn - đây là một giao dịch nên mất vài giây.</string>
    <string name="kp_8ad85cccbb0e" formatted="false">Nhấn để quay lại</string>
    <string name="kp_0e4268b5d759" formatted="false">Mã người tạo không đúng.</string>
    <string name="kp_617a81cfb251" formatted="false">Thao tác chưa tới được mạng. Hãy thử lại.</string>
    <string name="kp_55720cd06fc4" formatted="false">Phòng đó đã đầy trước - đang tìm phòng tiếp theo cho bạn.</string>
    <string name="kp_d8501167e501" formatted="false">Phòng đó đã đầy trước. Nhấn Tham gia để thử phòng tiếp theo.</string>
    <string name="kp_9e663d4025b0" formatted="false">Giải đấu đó đã bắt đầu.</string>
    <string name="kp_1ee44a0bf66b" formatted="false">Không kết nối được máy chủ cờ vua và mạng chưa xác nhận việc này. Hãy thử lại sau giây lát.</string>
    <string name="kp_0e3db8107f4d" formatted="false">Không kết nối được máy chủ cờ vua nên không thể xác nhận các phòng đang mở. Hãy thử lại khi máy chủ hoạt động trở lại.</string>
    <string name="kp_3e86d5e865a8" formatted="false">Không kết nối được máy chủ cờ vua nên không thể tra mã đó. Hãy thử lại khi máy chủ hoạt động trở lại.</string>
    <string name="kp_374e3b271476" formatted="false">Mã tám ký tự mà người tạo đã chia sẻ. Tham gia là một giao dịch (phí: %s).</string>
    <string name="kp_668f15ee8377" formatted="false">Bản thân ván cờ miễn phí. Khi kết thúc, dù thắng hay thua, kết quả được ghi lên Kaspa: một giao dịch từ ví của bạn, khoảng %s.</string>
    <string name="kp_056a66088f6c" formatted="false">Bản thân ván cờ miễn phí. Khi kết thúc, dù thắng hay thua, kết quả được ghi lên Kaspa: một giao dịch từ ví của bạn, một khoản phí nhỏ.</string>
    <string name="kp_a94070f3a397" formatted="false">Mạng vẫn đang xác nhận lần gửi trước của bạn. Vui lòng thử lại sau vài giây.</string>
    <string name="kp_5021101f57d6" formatted="false">Kết quả được ghi lên Kaspa khi ván đấu kết thúc</string>
    <string name="kp_fb4fdd00f1ac" formatted="false">Ghi kết quả thất bại. Nếu bạn rời đi bây giờ, kết quả sẽ không thể gửi lại và chiến thắng này sẽ không được tính trên bảng xếp hạng.</string>
    <string name="kp_2d72f92d9b82" formatted="false">Kết quả có thể đã được ghi</string>
    <string name="kp_30a77c98dc8a" formatted="false">Giải đấu tự bắt đầu khi đủ cả tám chỗ.</string>
    <string name="kp_693f8a669f1e" formatted="false">Lượt đối thủ</string>
    <string name="kp_3dd518e63c49" formatted="false">Đối thủ</string>
    <string name="kp_22a02413aebd" formatted="false">Luôn có một phòng công khai chờ người chơi. Khi đầy, giải bắt đầu và phòng tiếp theo mở ra. Tám người chơi, loại trực tiếp, mỗi bên năm phút. Mỗi nước đi là một giao dịch Kaspa (khoảng 0.0017 KAS mỗi nước).</string>
    <string name="kp_6d45876eef92" formatted="false">Suy nghĩ sâu và nhìn xa. Thắng được đối thủ này là bạn đã leo hết cả thang.</string>
    <string name="kp_1085f4e7c41f" formatted="false">Ván này được chơi trên một tài khoản khác. Hãy đăng nhập vào tài khoản đó để ghi kết quả.</string>
    <string name="kp_9fa87800a939" formatted="false">Giao dịch có thể đã đi, nhưng mạng chưa xác nhận. Hãy kiểm tra số dư trước khi gửi lại.</string>
