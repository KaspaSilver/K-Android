    <string name="kp_9be1abba9272" formatted="false">Tiếp tục chờ</string>
    <string name="kp_32bf913a5258" formatted="false">Biết cách đi của mọi quân và thích ăn quân miễn phí. Coi chừng những con tốt không được bảo vệ.</string>
