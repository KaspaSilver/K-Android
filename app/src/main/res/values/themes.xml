<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Compose handles all visual styling; this just sets the window background.
         Must descend from a Theme.AppCompat theme: MainActivity extends AppCompatActivity (for
         AppCompatDelegate.setApplicationLocales' per-app language backport), which throws at
         setContentView if the activity theme isn't an AppCompat theme or descendant.
         DayNight, and the window background the launch colour (white, black in dark mode): the
         window follows the app's Appearance setting (iOS 518fdc8c `WindowAppearance`), so what
         shows before Compose draws, and around it, is never the other appearance. -->
    <style name="Theme.KaChat" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_bars</item>
    </style>
</resources>
