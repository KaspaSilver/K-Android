<resources>
    <string name="kpui_terms_no_abuse_title">אין תוכן פוגעני או התעללות</string>
    <string name="kpui_terms_no_abuse_body">ב-K אין סובלנות לתוכן פוגעני או למשתמשים מתעללים. אסור לפרסם דבר שאינו חוקי, תוכן מיני הכולל ילדים, דברי שנאה, איומים, הטרדה, תוכן שמעודד אלימות או פגיעה עצמית, או הונאות. חשבונות שעושים זאת עשויים להיות מוסרים ממה ש-K מציג, ללא הודעה מראש.</string>
    <string name="kpui_terms_public_title">הפוסטים שלך ציבוריים וקבועים</string>
    <string name="kpui_terms_public_body">פוסטים, תגובות, לייקים והודעות חדר הם עסקאות ציבוריות ברשת Kaspa. אתה אחראי למה שאתה מפרסם. מחיקת פוסט מסירה אותו מ-K, אבל אף אחד לא יכול למחוק עסקה מהרשת.</string>
    <string name="kpui_terms_reporting_title">דיווח וחסימה</string>
    <string name="kpui_terms_reporting_body">השתמש בדיווח על פוסט או הודעת חדר כדי לספר לנו על תוכן פוגעני; אדם קורא כל דיווח. השתמש בחסימה כדי להפסיק לראות פוסטים והודעות חדר של חשבון. אנחנו יכולים להסיר תוכן וחשבונות מהאינדקסר של K, ש-K קורא כברירת מחדל.</string>
    <string name="kpui_terms_account_title">החשבון שלך והכספים שלך</string>
    <string name="kpui_terms_account_body">החשבון שלך הוא 12 או 24 מילים השמורות במכשיר שלך. הן אף פעם לא אצלנו, ולכן איננו יכולים לשחזר מילים שאבדו או לבטל עסקה. פרסום עולה עמלת רשת ב-KAS, ואתה אחראי לכספים שאתה מחזיק ושולח.</string>
    <string name="kpui_terms_warranty_title">ללא אחריות</string>
    <string name="kpui_terms_warranty_body">K מסופק כמות שהוא, ללא אחריות, ובמידה שהחוק מתיר איננו אחראים להפסדים משימוש בו או ממה שמשתמשים אחרים מפרסמים. תנאים אלה הם בינך לבין מפתח K, ולא Google.</string>
